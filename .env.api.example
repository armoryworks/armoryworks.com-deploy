# Copy to .env on armoryworks-api and fill in. Never commit .env.
#
# This drives docker-compose.api.yml (Postgres + .NET API on the Minisforum).
# UI-side knobs (UI_PORT etc.) are NOT in this file — see .env.web.example.
#
# aw-deploy rewrites SERVER_IMAGE_TAG on every deploy. Hand-edits to that
# value are lost on the next aw-deploy run.

# ---- Image tag (managed by aw-deploy) ---------------------------------------
# Set by setup-api.sh on first run, then maintained by aw-deploy on every
# subsequent deploy. Format: main-<7-hex> or <X.Y.Z>. NEVER 'latest' in prod.
SERVER_IMAGE_TAG=

# ---- Database ---------------------------------------------------------------
POSTGRES_DB=armory_works_db
POSTGRES_USER=armory_works
# REQUIRED. Generate with `openssl rand -base64 32` and stash in 1Password.
POSTGRES_PASSWORD=

# ---- API --------------------------------------------------------------------
# Listens on 0.0.0.0:8203 inside the host. UFW restricts to 192.168.1.0/24.
API_PORT=8203

# ---- Outbound email ---------------------------------------------------------
# In production set LogInsteadOfSend=false and fill SMTP credentials.
EMAIL_LOG_INSTEAD_OF_SEND=false
EMAIL_FROM_ADDRESS=info@armoryworks.com
EMAIL_FROM_DISPLAY_NAME="Armory Works"
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# Where contact submissions are routed.
CONTACT_NOTIFICATION_EMAIL=info@armoryworks.com

# ---- Cross-site read --------------------------------------------------------
QB_ENGINEER_BASE_URL=https://qb-engineer.com

# ---- OIDC (Google Workspace) ------------------------------------------------
OIDC_AUTHORITY=https://accounts.google.com
OIDC_CLIENT_ID=825387266488-ebh8gh62rllfvdcdh15g0kkcl22fhqtb.apps.googleusercontent.com
OIDC_CLIENT_SECRET=
OIDC_CALLBACK_PATH=/signin-oidc
OIDC_SIGNED_OUT_CALLBACK_PATH=/signout-callback-oidc
OIDC_ALLOWED_HOSTED_DOMAIN=armoryworks.com

# ---- Lead relay (Apps Script → Sheets) --------------------------------------
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
