#!/usr/bin/env bash
# aw-deploy — Operator-driven deploy CLI for armoryworks.com.
#
# armoryworks.com is a single static site: one container (the nginx image
# built from the source repo), one box. This CLI pulls the image from
# ghcr.io/armoryworks/armory-works-ui, pins UI_IMAGE_TAG in .env, recreates
# the container, and gates on a host-PUBLISHED-port health check with
# rollback. State + log retained on the host.
#
# Conventions shared with forge-deploy (the reference) — see the source repo's
# docs/deploy-conventions.md. armoryworks.com implements only the trivial
# single-service slice: no topology wizard, no component scope, no DB /
# migrations / profiles.
#
# Bash conventions: set -euo pipefail · quote everything · [[ ]] over [ ] ·
# never deploys 'latest'.

set -euo pipefail

# ─────────────────────────────────────────────────────────────
# Constants
# ─────────────────────────────────────────────────────────────

readonly AW_DEPLOY_VERSION="0.2.0"
readonly REPO_ROOT="${AW_DEPLOY_REPO:-/opt/armoryworks-deploy}"
readonly STATE_DIR="/etc/armoryworks"
readonly STATE_FILE="${STATE_DIR}/deploy-state.json"
readonly LOG_FILE="/var/log/aw-deploy.log"
readonly ENV_FILE="${REPO_ROOT}/.env"
readonly COMPOSE_WEB="${REPO_ROOT}/docker-compose.web.yml"
readonly REGISTRY_HOST="ghcr.io"
readonly REGISTRY_OWNER="armoryworks"

# The one service. armoryworks.com is a single static container.
readonly IMAGE_REPO="armory-works-ui"
readonly IMAGE_ENVVAR="UI_IMAGE_TAG"
readonly COMPOSE_SERVICE="armory-works-ui"
readonly HEALTH_PATH="/"          # static site root returns 200 when healthy

# Max seconds to wait for the published port to answer before rolling back.
# Override per host via .env (HEALTHCHECK_TIMEOUT_SECS=...) or a shell env var.
readonly HEALTHCHECK_TIMEOUT_DEFAULT=120
readonly HEALTHCHECK_POLL_INTERVAL=3

# GHCR auth: PAT with read:packages scope (the package is private).
# install-aw-deploy.sh writes these.
readonly GHCR_USER_FILE="${STATE_DIR}/ghcr-user"
readonly GHCR_TOKEN_FILE="${STATE_DIR}/ghcr-token"

# Tag format regexes
readonly TAG_RE_SHA='^main-[a-f0-9]{7,40}$'
readonly TAG_RE_SEMVER='^[0-9]+\.[0-9]+\.[0-9]+$'

# ─────────────────────────────────────────────────────────────
# Color output (respects NO_COLOR)
# ─────────────────────────────────────────────────────────────

if [[ -n "${NO_COLOR:-}" ]] || [[ ! -t 1 ]]; then
  C_RESET=""; C_DIM=""; C_RED=""; C_GREEN=""; C_YELLOW=""; C_CYAN=""; C_BOLD=""
else
  C_RESET=$'\033[0m'
  C_DIM=$'\033[2m'
  C_RED=$'\033[31m'
  C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'
  C_CYAN=$'\033[36m'
  C_BOLD=$'\033[1m'
fi

step() { printf '%s==> %s%s\n' "${C_CYAN}" "$1" "${C_RESET}"; }
ok()   { printf '    %s[OK]%s %s\n' "${C_GREEN}" "${C_RESET}" "$1"; }
warn() { printf '    %s[!!]%s %s\n' "${C_YELLOW}" "${C_RESET}" "$1"; }
err()  { printf '    %s[XX]%s %s\n' "${C_RED}" "${C_RESET}" "$1" >&2; }
die()  { err "$1"; exit "${2:-1}"; }

# ─────────────────────────────────────────────────────────────
# Usage
# ─────────────────────────────────────────────────────────────

usage() {
  cat <<EOF
aw-deploy ${AW_DEPLOY_VERSION} — armoryworks.com deploy CLI

USAGE:
  aw-deploy                  Interactive: pick a recent version, deploy it
  aw-deploy <tag>            Deploy a specific tag (semver X.Y.Z or main-<sha>)
  aw-deploy --up             Bring the container up on the currently pinned tag
  aw-deploy compose <args>   Scope-aware 'docker compose' passthrough (use this,
                             not bare docker compose)
  aw-deploy --list           List recent X.Y.Z versions in GHCR
  aw-deploy --list --builds  List recent main-<sha> build tags instead
  aw-deploy --status         Show deployed version + container health
  aw-deploy --rollback       Re-pin to the previously deployed version
  aw-deploy --logs           Tail the deploy history log
  aw-deploy --self-update    git pull this repo + reinstall the CLI
  aw-deploy --help           This usage

EXAMPLES:
  aw-deploy 0.1.11           Deploy that version
  aw-deploy main-c3f04bc     Deploy a specific build SHA
  aw-deploy --up             Recreate on the pinned tag (e.g. after a compose edit)

NOTES:
  * Single static service (armory-works-ui). One container, one box.
  * Both X.Y.Z versions and main-<sha> tags are accepted; 'latest' is refused.
  * Health gate curls the host-published port (127.0.0.1:UI_PORT/), not just
    the container's internal healthcheck.
  * State: ${STATE_FILE}   Log: ${LOG_FILE}   Repo: ${REPO_ROOT}
EOF
}

# ─────────────────────────────────────────────────────────────
# Pre-flight (inline guards; see scripts/aw-preflight for the full doctor)
# ─────────────────────────────────────────────────────────────

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "Missing required command: $1 (run scripts/install-aw-deploy.sh)"
}

preflight() {
  require_cmd docker
  require_cmd curl
  require_cmd jq
  docker compose version >/dev/null 2>&1 || die "docker compose plugin missing"

  [[ -f "$COMPOSE_WEB" ]] || die "Compose file not found: $COMPOSE_WEB (set AW_DEPLOY_REPO?)"
  [[ -f "$ENV_FILE" ]]    || die "Env file not found: $ENV_FILE (run setup-web.sh first)"
  [[ -f "$STATE_FILE" ]]  || die "State file not found: $STATE_FILE (run scripts/install-aw-deploy.sh)"
  [[ -w "$STATE_FILE" ]]  || die "State file not writable: $STATE_FILE"
  [[ -w "$LOG_FILE" ]]    || die "Log file not writable: $LOG_FILE"
  if [[ ! -r "$GHCR_USER_FILE" || ! -r "$GHCR_TOKEN_FILE" ]]; then
    die "GHCR credentials missing at $GHCR_USER_FILE / $GHCR_TOKEN_FILE — run scripts/install-aw-deploy.sh"
  fi
}

# ─────────────────────────────────────────────────────────────
# Tag validation
# ─────────────────────────────────────────────────────────────

validate_tag() {
  local tag="$1"
  if [[ "$tag" == "latest" ]]; then
    die "Refusing to deploy 'latest' — pass a main-<sha> or <X.Y.Z> tag (try: aw-deploy --list)"
  fi
  if [[ ! "$tag" =~ $TAG_RE_SHA ]] && [[ ! "$tag" =~ $TAG_RE_SEMVER ]]; then
    die "Invalid tag format: '$tag' (expected main-<hex> or X.Y.Z)"
  fi
}

# ─────────────────────────────────────────────────────────────
# GHCR API (private image — Basic Auth with a PAT)
# ─────────────────────────────────────────────────────────────

ghcr_basic_creds() {
  [[ -r "$GHCR_USER_FILE" && -r "$GHCR_TOKEN_FILE" ]] || return 0
  local user token
  user=$(tr -d '\n\r' < "$GHCR_USER_FILE")
  token=$(tr -d '\n\r' < "$GHCR_TOKEN_FILE")
  [[ -n "$user" && -n "$token" ]] || return 0
  printf '%s:%s' "$user" "$token"
}

ghcr_token() {
  local repo="$1" creds
  creds=$(ghcr_basic_creds)
  [[ -n "$creds" ]] || die "GHCR credentials missing — run scripts/install-aw-deploy.sh"
  curl -fsSL -u "$creds" \
    "https://${REGISTRY_HOST}/token?service=${REGISTRY_HOST}&scope=repository:${REGISTRY_OWNER}/${repo}:pull" \
    | jq -r '.token'
}

ghcr_list_tags() {
  local repo="$1" token
  token=$(ghcr_token "$repo") || return 1
  [[ -n "$token" ]] || return 1
  curl -fsSL \
    -H "Authorization: Bearer $token" \
    -H "Accept: application/vnd.oci.image.index.v1+json" \
    "https://${REGISTRY_HOST}/v2/${REGISTRY_OWNER}/${repo}/tags/list" \
    | jq -r '.tags[]?' \
    || true
}

ghcr_tag_exists() {
  local repo="$1" tag="$2" token http_code
  token=$(ghcr_token "$repo") || return 1
  [[ -n "$token" ]] || return 1
  http_code=$(curl -s -o /dev/null -w '%{http_code}' \
    -H "Authorization: Bearer $token" \
    -H "Accept: application/vnd.docker.distribution.manifest.v2+json" \
    -H "Accept: application/vnd.oci.image.manifest.v1+json" \
    -H "Accept: application/vnd.oci.image.index.v1+json" \
    -H "Accept: application/vnd.docker.distribution.manifest.list.v2+json" \
    "https://${REGISTRY_HOST}/v2/${REGISTRY_OWNER}/${repo}/manifests/${tag}" \
    -X HEAD)
  [[ "$http_code" == "200" ]]
}

# ─────────────────────────────────────────────────────────────
# State + .env + log helpers
# ─────────────────────────────────────────────────────────────

state_get() {
  local field="${1:-}"
  if [[ -z "$field" ]]; then
    jq -r --arg r "$IMAGE_REPO" '.[$r] // {} | tojson' "$STATE_FILE"
  else
    jq -r --arg r "$IMAGE_REPO" --arg f "$field" '.[$r][$f] // ""' "$STATE_FILE"
  fi
}

state_set() {
  local new_tag="$1" now tmp prior_tag
  now=$(date -u +'%Y-%m-%dT%H:%M:%SZ')
  prior_tag=$(state_get current)
  tmp=$(mktemp)
  jq --arg r "$IMAGE_REPO" --arg cur "$new_tag" --arg prior "$prior_tag" --arg ts "$now" \
    '.[$r] = {current: $cur, prior: $prior, deployedAt: $ts}' \
    "$STATE_FILE" > "$tmp"
  mv "$tmp" "$STATE_FILE"
  chmod 0640 "$STATE_FILE" 2>/dev/null || true
}

env_get() {
  local key="$1"
  if grep -qE "^${key}=" "$ENV_FILE" 2>/dev/null; then
    grep -E "^${key}=" "$ENV_FILE" | head -1 | cut -d= -f2-
  fi
}

env_set() {
  local key="$1" val="$2" tmp
  tmp=$(mktemp)
  if grep -qE "^${key}=" "$ENV_FILE"; then
    awk -v k="$key" -v v="$val" '
      BEGIN { FS=OFS="=" }
      $1==k { print k "=" v; next }
      { print }
    ' "$ENV_FILE" > "$tmp"
  else
    cp "$ENV_FILE" "$tmp"
    printf '%s=%s\n' "$key" "$val" >> "$tmp"
  fi
  mv "$tmp" "$ENV_FILE"
}

# Effective health timeout: .env override > shell env > default. Validated to a
# positive int so a typo can't make the wait loop exit immediately.
health_timeout() {
  local v
  v=$(env_get HEALTHCHECK_TIMEOUT_SECS)
  v="${v:-${HEALTHCHECK_TIMEOUT_SECS:-$HEALTHCHECK_TIMEOUT_DEFAULT}}"
  [[ "$v" =~ ^[1-9][0-9]*$ ]] || v="$HEALTHCHECK_TIMEOUT_DEFAULT"
  printf '%s' "$v"
}

log_event() {
  local from="$1" to="$2" outcome="$3" ts
  ts=$(date -u +'%Y-%m-%dT%H:%M:%SZ')
  printf '%s %s %s -> %s %s\n' "$ts" "$COMPOSE_SERVICE" "${from:-<none>}" "$to" "$outcome" >> "$LOG_FILE"
}

# ─────────────────────────────────────────────────────────────
# Compose + health
# ─────────────────────────────────────────────────────────────

compose() {
  docker compose --env-file "$ENV_FILE" -f "$COMPOSE_WEB" "$@"
}

# Wait for the host-PUBLISHED port to answer 200. This verifies what host nginx
# actually proxies to — not merely the container's internal healthcheck. A
# container can report "healthy" on its internal port while the published port
# maps to the wrong container port (the 8080-vs-80 mismatch that 502'd the
# live site). Returns 0 healthy, 1 timeout.
wait_healthy() {
  local elapsed=0 timeout port
  timeout=$(health_timeout)
  port=$(env_get UI_PORT || true); port="${port:-4203}"
  while (( elapsed < timeout )); do
    if curl -fsS --max-time 3 "http://127.0.0.1:${port}${HEALTH_PATH}" >/dev/null 2>&1; then
      return 0
    fi
    sleep "$HEALTHCHECK_POLL_INTERVAL"
    elapsed=$(( elapsed + HEALTHCHECK_POLL_INTERVAL ))
  done
  return 1
}

# ─────────────────────────────────────────────────────────────
# Commands
# ─────────────────────────────────────────────────────────────

cmd_list() {
  local mode="${1:-versions}"   # versions (semver) | builds (main-<sha>)
  printf '\n%sAvailable tags%s (mode=%s)\n\n' "${C_BOLD}" "${C_RESET}" "$mode"
  printf '%s%s%s\n' "${C_CYAN}" "$IMAGE_REPO" "${C_RESET}"
  local tags pattern matched
  tags=$(ghcr_list_tags "$IMAGE_REPO" 2>/dev/null || true)
  if [[ -z "$tags" ]]; then
    printf '  %s(no tags found or image not yet published)%s\n\n' "${C_DIM}" "${C_RESET}"
    return 0
  fi
  case "$mode" in
    versions) pattern='^[0-9]+\.[0-9]+\.[0-9]+$'; matched=$(printf '%s\n' "$tags" | grep -E "$pattern" | sort -Vr | head -10) ;;
    builds)   pattern='^main-[a-f0-9]+$';          matched=$(printf '%s\n' "$tags" | grep -E "$pattern" | sort -r  | head -10) ;;
    *)        matched=$tags ;;
  esac
  if [[ -z "$matched" ]]; then
    printf '  %s(no tags matching %s)%s\n' "${C_DIM}" "$pattern" "${C_RESET}"
  else
    printf '%s\n' "$matched" | sed 's/^/  /'
  fi
  printf '\n'
}

cmd_status() {
  printf '\n%sDeploy status%s\n\n' "${C_BOLD}" "${C_RESET}"
  local cur prior deployedAt cid health_status
  cur=$(state_get current)
  prior=$(state_get prior)
  deployedAt=$(state_get deployedAt)
  cid=$(compose ps -q "$COMPOSE_SERVICE" 2>/dev/null || true)
  if [[ -n "$cid" ]]; then
    health_status=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{if .State.Running}}running{{else}}stopped{{end}}{{end}}' "$cid" 2>/dev/null || echo unknown)
  else
    health_status="not-running"
  fi
  printf '%s%s%s\n' "${C_CYAN}" "$COMPOSE_SERVICE" "${C_RESET}"
  printf '  current:    %s\n' "${cur:-<none>}"
  printf '  prior:      %s\n' "${prior:-<none>}"
  printf '  deployedAt: %s\n' "${deployedAt:-<none>}"
  printf '  container:  %s\n\n' "$health_status"
}

cmd_logs() {
  [[ -s "$LOG_FILE" ]] || { warn "Log is empty: $LOG_FILE"; return 0; }
  tail -n 50 "$LOG_FILE"
}

cmd_up() {
  preflight
  local tag
  tag=$(env_get "$IMAGE_ENVVAR" || true)
  if [[ -z "$tag" || "$tag" == "latest" ]]; then
    die "$IMAGE_ENVVAR is '${tag:-unset}' — pin an immutable tag first (aw-deploy <X.Y.Z|main-sha>)"
  fi
  step "Bringing up $COMPOSE_SERVICE on pinned $tag"
  compose up -d --force-recreate "$COMPOSE_SERVICE"
  step "Waiting for healthy ($(health_timeout) s max)"
  if wait_healthy; then
    ok "Service healthy on the published port"
    state_set "$tag"
  else
    err "Published port did not answer — check 'aw-deploy --status' and host nginx"
    return 1
  fi
}

cmd_compose() {
  preflight
  [[ $# -gt 0 ]] || die "aw-deploy compose <args> — e.g. 'compose ps', 'compose logs -f armory-works-ui'"
  compose "$@"
}

cmd_self_update() {
  step "Self-update: $REPO_ROOT"
  [[ -d "${REPO_ROOT}/.git" ]] || die "Not a git checkout: $REPO_ROOT"
  if ! git -C "$REPO_ROOT" diff --quiet HEAD -- 2>/dev/null; then
    die "Local changes to tracked files present in $REPO_ROOT — refusing to pull"
  fi
  git -C "$REPO_ROOT" pull --ff-only
  ok "Pulled latest"
  if [[ -x "${REPO_ROOT}/scripts/install-aw-deploy.sh" ]]; then
    sudo "${REPO_ROOT}/scripts/install-aw-deploy.sh" --skip-auth
  else
    warn "install-aw-deploy.sh not found or not executable"
  fi
}

pick_tag_interactive() {
  local tags
  tags=$(ghcr_list_tags "$IMAGE_REPO" 2>/dev/null | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -Vr | head -5 || true)
  [[ -z "$tags" ]] && tags=$(ghcr_list_tags "$IMAGE_REPO" 2>/dev/null | grep -E '^main-[a-f0-9]+$' | sort -r | head -5 || true)
  [[ -z "$tags" ]] && die "No version or main-<sha> tags available for $IMAGE_REPO"
  printf '\nRecent versions for %s:\n' "$IMAGE_REPO" >&2
  local i=1 tag_array=()
  while IFS= read -r t; do
    [[ -z "$t" ]] && continue
    tag_array+=("$t")
    printf '  [%d] %s\n' "$i" "$t" >&2
    i=$(( i + 1 ))
  done <<<"$tags"
  printf '\nChoose [1-%d] (Enter for 1, q to cancel): ' "${#tag_array[@]}" >&2
  local choice; read -r choice
  [[ "$choice" == "q" || "$choice" == "Q" ]] && die "Cancelled by user"
  choice="${choice:-1}"
  if ! [[ "$choice" =~ ^[0-9]+$ ]] || (( choice < 1 || choice > ${#tag_array[@]} )); then
    die "Invalid choice: $choice"
  fi
  printf '%s\n' "${tag_array[$(( choice - 1 ))]}"
}

deploy() {
  local target_tag="$1" prior_tag
  prior_tag=$(state_get current)
  [[ -z "$prior_tag" ]] && prior_tag=$(env_get "$IMAGE_ENVVAR")

  step "Deploying $COMPOSE_SERVICE -> $target_tag"

  if ! ghcr_tag_exists "$IMAGE_REPO" "$target_tag"; then
    err "Tag not found in GHCR: ${REGISTRY_OWNER}/${IMAGE_REPO}:${target_tag}"
    log_event "$prior_tag" "$target_tag" "missing-in-ghcr"
    return 1
  fi
  ok "Tag verified in GHCR"

  env_set "$IMAGE_ENVVAR" "$target_tag"
  ok ".env updated: ${IMAGE_ENVVAR}=${target_tag}"

  if ! compose pull "$COMPOSE_SERVICE"; then
    err "docker compose pull failed"
    env_set "$IMAGE_ENVVAR" "$prior_tag"
    log_event "$prior_tag" "$target_tag" "pull-failed"
    return 1
  fi
  ok "Image pulled"

  if ! compose up -d --force-recreate "$COMPOSE_SERVICE"; then
    err "docker compose up -d failed — rolling back"
    env_set "$IMAGE_ENVVAR" "$prior_tag"
    compose up -d --force-recreate "$COMPOSE_SERVICE" || true
    log_event "$prior_tag" "$target_tag" "up-failed"
    return 1
  fi
  ok "Container started"

  step "Waiting for healthy ($(health_timeout) s max)"
  if wait_healthy; then
    ok "Service healthy on the published port"
    state_set "$target_tag"
    log_event "$prior_tag" "$target_tag" "ok"
    return 0
  fi

  err "Published port did not answer — rolling back to ${prior_tag:-<none>}"
  if [[ -n "$prior_tag" && "$prior_tag" != "$target_tag" ]]; then
    env_set "$IMAGE_ENVVAR" "$prior_tag"
    compose up -d --force-recreate "$COMPOSE_SERVICE" || true
  fi
  log_event "$prior_tag" "$target_tag" "unhealthy-rolled-back"
  return 1
}

cmd_rollback() {
  local prior
  prior=$(state_get prior)
  [[ -n "$prior" ]] || die "No prior tag recorded — nothing to roll back to"
  step "Rollback $COMPOSE_SERVICE -> $prior"
  deploy "$prior"
}

# ─────────────────────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────────────────────

main() {
  # `compose` subcommand: pass everything after it to the scoped wrapper.
  if [[ "${1:-}" == "compose" ]]; then
    shift; cmd_compose "$@"; return
  fi

  if [[ $# -eq 0 ]]; then
    preflight
    local tag; tag=$(pick_tag_interactive)
    validate_tag "$tag"
    deploy "$tag" || { err "Deploy failed — check $LOG_FILE"; exit 1; }
    return
  fi

  local mode="" positional="" list_mode="versions"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h)     usage; exit 0 ;;
      --version|-V)  printf 'aw-deploy %s\n' "$AW_DEPLOY_VERSION"; exit 0 ;;
      --list)        mode="list"; shift ;;
      --releases)    list_mode="versions"; shift ;;
      --builds)      list_mode="builds"; shift ;;
      --status)      mode="status"; shift ;;
      --rollback)    mode="rollback"; shift ;;
      --logs)        mode="logs"; shift ;;
      --up|--start)  mode="up"; shift ;;
      --self-update) mode="self-update"; shift ;;
      -*)            die "Unknown option: $1 (try --help)" ;;
      *)
        [[ -n "$positional" ]] && die "Unexpected extra argument: $1"
        positional="$1"; shift ;;
    esac
  done

  case "$mode" in
    list)        preflight; cmd_list "$list_mode" ;;
    status)      preflight; cmd_status ;;
    rollback)    preflight; cmd_rollback ;;
    logs)        cmd_logs ;;
    up)          cmd_up ;;
    self-update) cmd_self_update ;;
    "")
      preflight
      validate_tag "$positional"
      deploy "$positional" || { err "Deploy failed — check $LOG_FILE"; exit 1; }
      ;;
    *) die "Internal error: unhandled mode '$mode'" ;;
  esac
}

main "$@"
