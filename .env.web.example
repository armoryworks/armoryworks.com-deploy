# Copy to .env on armoryworks-web and fill in. Never commit .env.
#
# This drives docker-compose.web.yml (Angular UI on the KAMRUI).
# API-side knobs (DB password, OIDC, SMTP, etc.) live on the api box —
# see .env.api.example.
#
# aw-deploy rewrites UI_IMAGE_TAG on every deploy. Hand-edits to that
# value are lost on the next aw-deploy run.

# ---- Image tag (managed by aw-deploy) ---------------------------------------
UI_IMAGE_TAG=

# ---- UI container -----------------------------------------------------------
# Binds to 127.0.0.1:UI_PORT only. Host nginx proxies external 443 → here.
UI_PORT=4203
