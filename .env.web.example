# Copy to .env on armoryworks-web and fill in. Never commit .env.
#
# This drives docker-compose.web.yml (the armoryworks.com static-site
# container). No API/DB on this box — the only dynamic input is the
# bind-mounted /writing content below.
#
# aw-deploy rewrites UI_IMAGE_TAG on every deploy. Hand-edits to that
# value are lost on the next aw-deploy run.

# ---- Image tag (managed by aw-deploy) ---------------------------------------
UI_IMAGE_TAG=

# ---- UI container -----------------------------------------------------------
# Binds to 127.0.0.1:UI_PORT only. Host nginx proxies external 443 → here.
UI_PORT=4203

# ---- Dynamic /writing content (Tuyere writing CMS) --------------------------
# Host dir the tuyere-writing-receiver writes into and the UI container mounts
# read-only at /usr/share/nginx/html/writing. tuyere-api (API box) POSTs each
# rendered publish to the receiver below; the receiver does the atomic extract
# + prune. setup-web.sh creates + seeds it.
WRITING_CONTENT_DIR=/var/lib/armoryworks/writing

# ---- Writing receiver (co-hosted with armory-works-ui) ----------------------
# Image tag (rolling edge during pre-1.0; pin a semver for production).
WRITING_RECEIVER_IMAGE_TAG=edge
# Bind / port. setup-web.sh auto-fills BIND with this box's detected LAN IP.
# Override here for multi-NIC hosts BEFORE running setup-web.sh.
WRITING_RECEIVER_BIND=127.0.0.1
WRITING_RECEIVER_PORT=5103
# Shared bearer token. setup-web.sh auto-generates this if blank/placeholder
# and prints a ready-to-paste snippet for the API box. Never commit a real one.
WRITING_RECEIVER_TOKEN=change-me-min-16-chars
# API box LAN IP — when set, setup-web.sh installs a UFW rule allowing only
# that source to reach WRITING_RECEIVER_PORT. Leave blank to skip the rule.
WRITING_RECEIVER_ALLOW_FROM=
